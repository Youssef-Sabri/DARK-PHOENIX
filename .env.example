# --- 1. SUPABASE DATABASE (Upload to: Vercel) ---
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# --- 2. SUPABASE S3 STORAGE (Upload to: Vercel, Hugging Face, Modal, Colab) ---
AWS_ACCESS_KEY_ID="YOUR_S3_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_S3_SECRET_ACCESS_KEY"
AWS_REGION="us-east-1"
AWS_ENDPOINT_URL_S3="https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3"
S3_BUCKET_NAME="dark-phoenix"

# --- 3. BACKEND ENDPOINT (Upload to: Vercel) ---
PROCESS_VIDEO_ENDPOINT="https://YOUR_SPACE_OR_MODAL_URL/process_video"
PROCESS_VIDEO_ENDPOINT_AUTH="YOUR_SECURE_RANDOM_BEARER_TOKEN"
# Note: In Hugging Face Secrets & Modal Secrets, set the token key name as AUTH_TOKEN

# --- 4. GEMINI AI (Upload to: Hugging Face, Modal, Colab) ---
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.1-flash-lite"

# --- 5. NEXTAUTH & APP CONFIG (Upload to: Vercel) ---
AUTH_SECRET="YOUR_NEXTAUTH_SECRET"
BASE_URL="http://localhost:3000"
SKIP_ENV_VALIDATION="true"
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# --- 6. INNGEST QUEUE (Upload to: Vercel) ---
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- 7. STRIPE BILLING (Upload to: Vercel) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SMALL_CREDIT_PACK="price_small_..."
STRIPE_MEDIUM_CREDIT_PACK="price_medium_..."
STRIPE_LARGE_CREDIT_PACK="price_large_..."
